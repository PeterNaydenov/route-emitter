// Types for the CommonJS build (dist/route-emitter.cjs) where `module.exports` is the routeEmitter function.
// Not generated by tsc. Reuses the ESM declarations from main.d.ts.
import type * as esm from './main.js' with { 'resolution-mode': 'import' };

declare const routeEmitter: typeof esm.default;

declare namespace routeEmitter {
    export type API            = esm.API;
    export type Address        = esm.Address;
    export type AddressHandler = esm.AddressHandler;
    export type ErrorHandler   = esm.ErrorHandler;
    export type RouterError    = esm.RouterError;
}

export = routeEmitter;
