{
  "name": "@peter.naydenov/route-emitter",
  "description": "Changes in URL are converted in events according routes definition list",
  "version": "2.3.2",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "src/main.js",
  "type": "module",
  "types": "types/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/main.d.ts",
        "default": "./src/main.js"
      },
      "require": {
        "types": "./types/main.d.cts",
        "default": "./dist/route-emitter.cjs"
      },
      "default": "./src/main.js"
    },
    "./package.json": "./package.json",
    "./dist/route-emitter.esm.js": {
      "types": "./types/main.d.ts",
      "default": "./dist/route-emitter.esm.js"
    },
    "./dist/route-emitter.cjs": {
      "types": "./types/main.d.cts",
      "default": "./dist/route-emitter.cjs"
    },
    "./dist/*": "./dist/*",
    "./src/*.js": {
      "types": "./types/*.d.ts",
      "default": "./src/*.js"
    },
    "./src/*": "./src/*",
    "./types/*": "./types/*",
    "./skills/*": "./skills/*"
  },
  "files": [
    "src",
    "dist",
    "types",
    "skills",
    "Changelog.md",
    "migration.guide.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "tsc -p tsconfig.json && node scripts/cts-types.js",
    "preview": "vite preview",
    "test": "vitest run && npm run test:types",
    "cover": "vitest run --coverage",
    "test:types": "tsc -p test/types/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterNaydenov/route-emitter.git"
  },
  "dependencies": {
    "@peter.naydenov/notice": "^2.6.2",
    "@peter.naydenov/url-pattern": "^1.0.7",
    "ask-for-promise": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "micro",
    "frontend",
    "MFE",
    "router",
    "emitter"
  ],
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
